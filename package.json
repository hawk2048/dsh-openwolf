{
    "name":  "dsh-openwolf",
    "version":  "0.8.11",
    "description":  "A compact code-map \u0027second brain\u0027 for DeepSeek Harness: pre-indexed project maps, per-file digests, session digests, read/write interception, and AGENTS.md injection so the agent stops re-reading whole files.",
    "type":  "module",
    "main":  "lib/index.js",
    "types":  "lib/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./lib/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib",
                  "cordis.patch.yml",
                  "bin",
                  "CHANGELOG.md",
                  "README-zh.md"
              ],
    "engines":  {
                    "node":  "\u003e=20.19.0"
                },
    "scripts":  {
                    "build":  "tsc -p tsconfig.json",
                    "prepare":  "tsc -p tsconfig.json",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "test":  "node --test \"test/**/*.test.ts\""
                },
    "keywords":  [
                     "deepseek-harness",
                     "dsh",
                     "cordis",
                     "plugin",
                     "code-map",
                     "code-map-agent",
                     "codegraph",
                     "agent-tools",
                     "agenda"
                 ],
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/hawk2048/dsh-openwolf.git"
                   },
    "bugs":  {
                 "url":  "https://github.com/hawk2048/dsh-openwolf/issues"
             },
    "homepage":  "https://github.com/hawk2048/dsh-openwolf#readme",
    "dependencies":  {
                         "@deepseek-ai/schemastery":  "^3.18.1",
                         "chokidar":  "^4.0.3"
                     },
    "optionalDependencies":  {
                                 "@lezer/go":  "^1.0.1",
                                 "@lezer/java":  "^1.1.3",
                                 "@lezer/javascript":  "^1.5.4",
                                 "@lezer/python":  "^1.1.19",
                                 "@lezer/rust":  "^1.0.2"
                             },
    "peerDependencies":  {
                             "@deepseek-ai/dsh-tools":  "^0.1.0-rc.6",
                             "@deepseek-ai/dsh-skill":  "^0.1.0-rc.6",
                             "@deepseek-ai/cordis":  "^4.0.1",
                             "@deepseek-ai/dsh-llm":  "^0.1.0-rc.6"
                         },
    "devDependencies":  {
                            "@types/node":  "^24.0.0",
                            "typescript":  "^5.9.0",
                            "@deepseek-ai/dsh-code-runtime":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-invariants":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-agent":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-user-approval":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-llm":  "^0.1.0-rc.6",
                            "@deepseek-ai/cordis-plugin-loader":  "^1.0.2",
                            "@deepseek-ai/dsh-skill":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-system-prompt":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-attachment":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-tools":  "^0.1.0-rc.6",
                            "chokidar":  "^4.0.3",
                            "@deepseek-ai/dsh-timeout":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-typert-protocol":  "^0.1.0-rc.6",
                            "@deepseek-ai/cordis":  "^4.0.1",
                            "@deepseek-ai/dsh-brand":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-scope":  "^0.1.0-rc.6",
                            "@deepseek-ai/cordis-plugin-include":  "^1.0.6",
                            "@deepseek-ai/schemastery":  "^3.18.1",
                            "@deepseek-ai/dsh-session":  "^0.1.0-rc.6"
                        },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "bin":  {
                "dshwolf":  "./bin/wolf.mjs",
                "wolf":  "./bin/wolf.mjs"
            }
}
